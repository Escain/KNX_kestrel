# Enforce the layering rules of specs/02-architecture.md at configure time:
#  - STD_ONLY libraries must not link any Qt module.
#  - Core libraries (everything except viewmodels/shell/automation/apps) must not link Qt GUI modules.

set(_kestrel_gui_modules Qt6::Gui Qt6::Widgets Qt6::Quick Qt6::QuickWidgets Qt6::QuickControls2 Qt6::Qml)
# GUI-tier targets, matched by prefix (qt_add_qml_module adds <target>plugin, <target>_resources_N, ...)
set(_kestrel_gui_layer_regex "^kestrel_(viewmodels|shell|automation|qml)")

function(_kestrel_collect_targets dir out)
	get_property(targets DIRECTORY ${dir} PROPERTY BUILDSYSTEM_TARGETS)
	get_property(subdirs DIRECTORY ${dir} PROPERTY SUBDIRECTORIES)
	foreach(sub IN LISTS subdirs)
		_kestrel_collect_targets(${sub} subtargets)
		list(APPEND targets ${subtargets})
	endforeach()
	set(${out} ${targets} PARENT_SCOPE)
endfunction()

_kestrel_collect_targets(${PROJECT_SOURCE_DIR}/src _kestrel_all)
foreach(t IN LISTS _kestrel_all)
	if(NOT t MATCHES "^kestrel_")
		continue()
	endif()
	get_target_property(type ${t} TYPE)
	if(NOT type STREQUAL "STATIC_LIBRARY")
		continue()
	endif()
	get_target_property(libs ${t} LINK_LIBRARIES)
	if(NOT libs)
		set(libs "")
	endif()
	get_target_property(stdOnly ${t} KESTREL_STD_ONLY)
	foreach(l IN LISTS libs)
		if(stdOnly AND l MATCHES "^Qt6::")
			message(FATAL_ERROR "Layering: ${t} is STD_ONLY but links ${l}")
		endif()
		if(NOT t MATCHES "${_kestrel_gui_layer_regex}" AND l IN_LIST _kestrel_gui_modules)
			message(FATAL_ERROR "Layering: core library ${t} must not link ${l}")
		endif()
	endforeach()
endforeach()
